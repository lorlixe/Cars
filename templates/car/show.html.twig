{% extends 'base.html.twig' %}

{% block title %}Détail d'un auteur
{% endblock %}

{% block body %}
	<style>
		.example-wrapper {
			margin: 1em auto;
			max-width: 800px;
			width: 95%;
			font: 18px / 1.5 sans-serif;
		}
		.example-wrapper code {
			background: #F5F5F5;
			padding: 2px 6px;
		}
	</style>
	<div class="example-wrapper">

		{% if car is not null %}
			<h1 class="mb-1">{{ car.name }}
			</h1>
			<div class="card mb-1 m-auto">
				<div class="card-body">
					<div class="card-title d-flex justify-content-between">

						<small class="text-muted">
							Nombre de places :
							{{ car.places.value }}</small>
					</div>
					<div class="card-title d-flex justify-content-between">
						<p>{{ car.description }}</p>


					</div>
					<small class="text-muted">
						Nombre de places :
						{{ car.motor.value }}</small>
				</div>
			</div>
			<a class="btn btn-danger" href="{{ path('app_car_remove',{id: car.id}) }}">Supprimer la voiture</a>
			<a class="btn btn-success" href="{{ path('app_admin_car_edit',{id: car.id}) }}">Modifier la voiture</a>
		{% else %}
			<div>Auteur non trouvé</div>
		{% endif %}

	</div>
{% endblock %}
