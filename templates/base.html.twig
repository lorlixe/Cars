<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta http-equiv="X-UA-Compatible" content="ie=edge">
		<title>
			{% block title %}Véhicloc
			{% endblock %}
		</title>

		<!-- Bootstrap CSS -->
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">


	</head>
	<body>

		<!-- ✅ Barre de navigation améliorée -->
		<nav class="navbar navbar-expand-lg navbar-light bg-light">
			<div class="container">
				<a class="navbar-brand fw-bold" href="{{ path('app_car_index') }}">Véhicloc</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse" id="navbarNav">
					<ul class="navbar-nav ms-auto">
						<li class="nav-item">
							<a class="nav-link" href="{{ path('app_car_index') }}">Accueil</a>
						</li>
						<li class="nav-item">
							<a class="btn btn-primary" href="{{ path('app_admin_car_new') }}">Ajouter une voiture</a>
						</li>
					</ul>
				</div>
			</div>
		</nav>

		{% block header %}{% endblock %}

		<main class="container my-4"> {% block body %}{% endblock %}
			</main>

			<!--  Footer  -->
			<footer class="bg-dark text-light py-4 mt-5">
				<div class="container">
					<div class="row">

						<div class="col-md-6">
							<h5>Conduire avec nous</h5>
							<ul class="list-unstyled">
								<li>
									<a href="#" class="text-light">Mentions légales</a>
								</li>
								<li>
									<a href="#" class="text-light">Nous contacter</a>
								</li>
								<li>
									<a href="#" class="text-light">Données personnelles</a>
								</li>
								<li>
									<a href="#" class="text-light">Questions fréquentes</a>
								</li>
							</ul>
						</div>

						<div class="col-md-6 text-md-end">

							<p class="mt-3 small">&copy; Véhicloc 2023</p>
						</div>
					</div>
				</div>
			</footer>

			<!-- Bootstrap JS -->
			<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

		</body>
	</html>
